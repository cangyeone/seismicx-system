{
  "name": "seismicx-system",
  "private": true,
  "version": "2.1.0-community.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "api": ".venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "collector": ".venv/bin/python -m backend.collector",
    "test:map": "node --experimental-strip-types --test tests/map_*.test.ts"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "d3": "^7.9.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
