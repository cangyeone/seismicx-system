# Standalone instance; coexist with other applications' nginx processes.
worker_processes auto;
pid /run/seismicx-nginx.pid;
error_log /var/log/nginx/seismicx-error.log warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /var/log/nginx/seismicx-access.log;
  server_tokens off;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_comp_level 5;
  gzip_types application/javascript text/javascript text/css application/json image/svg+xml;
  server {
    listen 80;
    server_name PUBLIC_RELAY_IP;
    location /.well-known/acme-challenge/ { root /var/www/seismicx-acme; }
    location / { return 302 https://$host:5012$request_uri; }
  }
  server {
    listen 5012 ssl;
    server_name PUBLIC_RELAY_IP;
    ssl_certificate /etc/letsencrypt/live/seismicx-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/seismicx-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    error_page 497 =302 https://$host:5012$request_uri;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    location / {
      proxy_pass http://127.0.0.1:15012;
      proxy_http_version 1.1;
      # Preserve the non-default public port for Origin/CSRF validation.
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_buffering off;
      proxy_read_timeout 180s;
    }
  }
}
