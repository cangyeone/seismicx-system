# Public read-only access; initialize /admin with scripts/admin_account.py.
SEISMICX_PLATFORM_NAME=SeismicX 边缘推理平台
SEISMICX_DATA_DIR=/data/seismicx/runtime
SEISMICX_SKILL_DIR=/data/seismicx/app/external/seismicx-catalog
SEISMICX_INFERENCE_BACKEND=bm1684x
SEISMICX_NPU_MODEL=/data/seismicx/models/pnsn_b8_f16.bmodel
SEISMICX_NPU_LIBRARY=/data/seismicx/models/libseismicx_npu.so
SEISMICX_EDGE_ENABLED=true
SEISMICX_EDGE_MAX_STATIONS=256
SEISMICX_EDGE_INTERVAL_SECONDS=60
SEISMICX_EDGE_WINDOW_SECONDS=300
SEISMICX_EDGE_INPUT_DELAY_SECONDS=20
SEISMICX_EDGE_MAX_INPUT_LAG_SECONDS=180
SEISMICX_EDGE_RUN_RETENTION_HOURS=2
SEISMICX_WAVEFORM_RETENTION_HOURS=6
SEISMICX_WAVEFORM_DISK_LIMIT_GB=12
SEISMICX_SEEDLINK_SERVER=geofon.gfz.de:18000
SEISMICX_SEEDLINK_SHARDS=8
SEISMICX_LLM_BASE_URL=http://127.0.0.1:8000/v1
SEISMICX_LLM_MODEL=qwen3.5-2b
SEISMICX_LLM_CONTEXT_TOKENS=7900
SEISMICX_LLM_OUTPUT_TOKENS=512
# Cloud model keys stay on the board; UI can select local or cloud independently.
SEISMICX_CLOUD_LLM_BASE_URL=
SEISMICX_CLOUD_LLM_MODEL=
SEISMICX_CLOUD_LLM_API_KEY=
