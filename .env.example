# Public read-only access; initialize /admin with scripts/admin_account.py.
# All timestamps and API dates are UTC. Default server binds to localhost.
SEISMICX_AUTO_SYNC=true
SEISMICX_SYNC_SECONDS=120
# Ollama or any OpenAI-compatible local/remote endpoint; secrets stay server-side.
SEISMICX_LLM_BASE_URL=http://127.0.0.1:11434/v1
SEISMICX_LLM_MODEL=gemma3:4b
SEISMICX_LLM_API_KEY=
SEISMICX_LLM_CONTEXT_TOKENS=7900
SEISMICX_LLM_OUTPUT_TOKENS=1400
SEISMICX_SEEDLINK_SERVER=geofon.gfz.de:18000
SEISMICX_QUEUE_CAPACITY=128
SEISMICX_WAVEFORM_RETENTION_DAYS=7
SEISMICX_WAVEFORM_DISK_LIMIT_GB=10

# Optional board NPU / cloud LLM: see deploy/edge/edge.env.example
SEISMICX_INFERENCE_BACKEND=cpu
SEISMICX_EDGE_ENABLED=false
SEISMICX_SEEDLINK_SHARDS=1
SEISMICX_CLOUD_LLM_BASE_URL=
SEISMICX_CLOUD_LLM_MODEL=
SEISMICX_CLOUD_LLM_API_KEY=

# Broadcast: public bulletins every >=30 seconds; one local-model brief per >=60s.
SEISMICX_CATALOG_POLL_SECONDS=30
# Default only; the authenticated admin settings can select local or cloud.
SEISMICX_BROADCAST_LLM_PROVIDER=local
SEISMICX_BROADCAST_AI_INTERVAL_SECONDS=60
# Optional workstation reuse of the board's public cached brief API.
# Example relay URL: https://edge.example.org:5012. Leave empty on the board itself.
SEISMICX_BROADCAST_RELAY_URL=
# Optional catalog-model relay: set the same random server-only secret on both
# workstation and board. Never expose this value to the frontend or commit it.
SEISMICX_MODEL_RELAY_KEY=
